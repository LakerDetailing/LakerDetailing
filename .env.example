# ══════════════════════════════════════════════════════════
#  LAKER DETAILING STUDIO — Environment Variables Reference
#  Kopiraj kao .env za lokalni razvoj (gitignored)
#  Za produkciju: postavi u Vercel Dashboard → Settings → Environment Variables
# ══════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────
# Project URL iz Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key (Sensitive!) — nikad ne izlagaj javno
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon/Public Key — koristi se u frontend kodu
# Supabase Dashboard → Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin Panel ───────────────────────────────────────────
# Lozinka za pristup /laker-admin-9x3k.html
# Koristi jaku lozinku (min 16 karaktera, mix slova/brojeva/simbola)
ADMIN_PASSWORD=your-strong-admin-password-here

# ── Brevo Email API ───────────────────────────────────────
# Brevo Dashboard → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PWA Push Notifikacije (VAPID) ─────────────────────────
# Generiše se jednom i ne menja — čuva se samo u Vercel-u!
# VAPID subject (tvoj email)
PUSH_VAPID_SUBJECT=mailto:detailinglaker@gmail.com

# VAPID Public Key (Base64URL format)
PUSH_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# VAPID Private Key (PEM format, Sensitive!)
PUSH_VAPID_PRIVATE_KEY_PEM=-----BEGIN EC PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END EC PRIVATE KEY-----
