        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content; script-src 'self' 'sha256-qoj9bMjVdgLlYoLZM6UykjPzoLSGENM7lgN7qXTJTFc=' 'sha256-SGo9PXuaO0V7oKXcaqCvdTz5Oz5QRFQ7MyoNBjs9N3Y=' 'sha256-BpOuXGZ94QBMfM0uDCszHjEId7DjDWdmlOCivSSEYyY=' 'sha256-GpLCpTvzTczTjMRlwU2XMlPIMQ2eTDtq7jD8POVMq2M=' 'sha256-64aHxoCa9N69Dv3AgCCNdXxXE+bw5y/yHjcDNnAGMLE=' 'sha256-EMOP5oS4qp0wtxWlLtqcyzZJru3NKDg0TRAF8i5PnSM=' 'sha256-J7Zrp0wPMCG50n47zSKZYtHZ8vU+x7CrqtqU97tZqos=' 'sha256-nSge21RGg4ybhfavSaFhNLRNhNQ63GMBEjMVlzAtl5w=' 'sha256-+rSnjFVvUFycZZyHz8ctw5s3q8WFhOEAKwG+FlG9Fzw=' 'sha256-JxKRa2oTsEqdFDbDyQnFPYMsOtvP/jmYQVaSBtut7HI=' 'sha256-uyMyaHsK++f1/h70PuU1TVmcPnYbBfKtMek7+RHlp4U=' 'sha256-jOamQrcUet/W6tb6qz+3fTgHKRVKIJ/N9MWSDZV9aLI=' 'sha256-iJSJ6tmaKdNBdiUM8CHoxA3NgATe3tQSwG/lBSTEbk4=' 'sha256-XxyEhNVbV0v/H7WPa/YM4WNGqUespuKrgfkASn5zlIc=' 'sha256-9wypX0fPGLCPFOxulQ1r9BuU+EujOR9lXAADDU+JTVU=' https://www.googletagmanager.com https://connect.facebook.net https://browser.sentry-cdn.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: https://www.facebook.com https://www.googletagmanager.com https://lh3.googleusercontent.com; connect-src 'self' https://api.brevo.com https://api.pwnedpasswords.com https://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://www.googletagmanager.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://accounts.google.com/gsi/ https://oauth2.googleapis.com; frame-src https://www.facebook.com https://accounts.google.com/gsi/ https://www.google.com https://maps.google.com; manifest-src 'self'; worker-src 'self'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
