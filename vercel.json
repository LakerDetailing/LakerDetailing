{
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/izvestaj",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/icons/favicon.ico"
    },
    {
      "source": "/loyalty-join",
      "destination": "/loyalty-join.html"
    },
    {
      "source": "/usluge",
      "destination": "/usluge.html"
    },
    {
      "source": "/premium-pranje",
      "destination": "/premium-pranje.html"
    },
    {
      "source": "/poliranje-laka",
      "destination": "/poliranje-laka.html"
    },
    {
      "source": "/keramicka-zastita",
      "destination": "/keramicka-zastita.html"
    },
    {
      "source": "/dubinsko-ciscenje",
      "destination": "/dubinsko-ciscenje.html"
    },
    {
      "source": "/poliranje-farova",
      "destination": "/poliranje-farova.html"
    },
    {
      "source": "/radovi",
      "destination": "/radovi.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/demo-a",
      "destination": "/demo-a.html"
    },
    {
      "source": "/demo-b",
      "destination": "/demo-b.html"
    },
    {
      "source": "/demo-c",
      "destination": "/demo-c.html"
    },
    {
      "source": "/demo-paketi",
      "destination": "/demo-paketi.html"
    },
    {
      "source": "/demo-cenovnik",
      "destination": "/demo-cenovnik.html"
    },
    {
      "source": "/demo-loyalty",
      "destination": "/demo-loyalty.html"
    },
    {
      "source": "/demo-o-nama",
      "destination": "/demo-o-nama.html"
    },
    {
      "source": "/demo-kontakt",
      "destination": "/demo-kontakt.html"
    }
  ],
  "redirects": [
    {
      "source": "/god",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rest/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:file*.md",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/.devcontainer/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/main.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/init.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Expires", "value": "Thu, 31 Dec 2026 23:59:59 GMT" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/laker-admin-9x3k.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
