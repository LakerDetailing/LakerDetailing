{
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/icons/favicon.ico"
    }
  ],
  "redirects": [
    {
      "source": "/god",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rest/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:file*.md",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/.devcontainer/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/supabase/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/main.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/laker-admin-9x3k.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=(), midi=(), serial=(), screen-wake-lock=(), fullscreen=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content; script-src 'self' 'sha256-BpOuXGZ94QBMfM0uDCszHjEId7DjDWdmlOCivSSEYyY=' 'sha256-GpLCpTvzTczTjMRlwU2XMlPIMQ2eTDtq7jD8POVMq2M=' 'sha256-0YEyg/rxuakMZ9LLSCytXIKbupAEoOPsc1iS2D5xq4w=' 'sha256-qoj9bMjVdgLlYoLZM6UykjPzoLSGENM7lgN7qXTJTFc=' https://www.googletagmanager.com https://connect.facebook.net https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.facebook.com https://www.googletagmanager.com; connect-src 'self' https://api.brevo.com https://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://www.googletagmanager.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io; frame-src https://www.facebook.com; manifest-src 'self'; worker-src 'self'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "unsafe-none" }
      ]
    }
  ]
}
